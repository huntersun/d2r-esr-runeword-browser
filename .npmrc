# npm 12 defaults allow-remote=none, which makes dry-run and --package-lock-only resolves fail with
# EALLOWREMOTE on the Tailwind wasm32-wasi fallback tarball (plain install/ci/update are unaffected).
# "all" restores the pre-npm-12 behaviour; the lockfile's integrity hashes still pin every tarball.
# Older npm versions ignore this key.
allow-remote=all
